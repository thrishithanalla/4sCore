# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/personnel_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET_KEY=your-refresh-token-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Configuration
MAX_SESSIONS_PER_USER=5
REFRESH_TOKEN_ROTATION=true

# Application Configuration
APP_NAME=CORE SERVICE  API's
APP_VERSION=1.0.0
DEBUG=True

# CORS Configuration
# Comma-separated list of allowed origins, or * to allow all
# Examples:
#   ALLOWED_ORIGINS=*
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai4andhrapolice.com
ALLOWED_ORIGINS=*

# Regex pattern for CORS origins (for dynamic matching like localhost with any port, subdomains)
# Default pattern supports: localhost/127.0.0.1/0.0.0.0 with any port, and *.ai4andhrapolice.com
# ALLOWED_ORIGIN_REGEX=^(http://(localhost|127\.0\.0\.1|0\.0\.0\.0)(:\d+)?|https://([a-zA-Z0-9-]+\.)?ai4andhrapolice\.com)$

# Notification Service Configuration
NOTIFICATION_SERVICE_URL=https://devapi.ai4andhrapolice.com/core-notifications

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+1234567890
OTP_EXPIRY_MINUTES=5
