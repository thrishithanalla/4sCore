# -------- Stage 1: Build --------
FROM baseimages.azurecr.io/node:20-base AS builder
WORKDIR /app

# Build-time env passed from Azure DevOps
ARG BUILD_ENV=dev

# Install deps first for better layer caching
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy source and build
COPY . .

RUN echo "Building FE for environment: ${BUILD_ENV}" && \
    npm run build:${BUILD_ENV}

# -------- Stage 2: Serve (Nginx) --------
FROM baseimages.azurecr.io/nginx:1.25-base

# Copy build output
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
